# PostgreSQL (Docker Compose)
# DATABASE_URL=postgresql+asyncpg://plum:plum@localhost:5432/plum_claims

POSTGRES_USER=plum
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=plum_claims
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:3000

# AI Provider (optional for local dev - tests run without)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VISION_MODEL=openai/gpt-6-luna
# TEXT_MODEL=openai/gpt-6-luna

# Policy
POLICY_DATA_DIR=data
SUBMISSION_LAG_DAYS=2

# Rate limits
RATE_LIMIT_IP_PER_MINUTE=5
RATE_LIMIT_EMPLOYEE_PER_MINUTE=3

# Document gate
DOCUMENT_GATE_TIMEOUT_SECONDS=60
DOCUMENT_GATE_MAX_ATTEMPTS=3